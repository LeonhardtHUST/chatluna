{
    "name": "moderation-kernel",
    "description": "Internal moderation orchestration kernel for ChatLuna",
    "version": "0.1.0",
    "main": "lib/index.cjs",
    "module": "lib/index.mjs",
    "typings": "lib/index.d.ts",
    "files": [
        "lib"
    ],
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.mjs",
            "require": "./lib/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "type": "module",
    "author": "LeonhardtHUST",
    "repository": {
        "type": "git",
        "url": "https://github.com/LeonhardtHUST/chatluna.git",
        "directory": "packages/moderation-kernel"
    },
    "license": "AGPL-3.0",
    "scripts": {
        "build": "atsc -b",
        "test": "yarn exec cross-env TS_NODE_PROJECT=tests/tsconfig.json mocha -r tsconfig-paths/register -r esbuild-register --exit \"tests/**/*.spec.ts\""
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "chatluna",
        "koishi",
        "moderation"
    ],
    "devDependencies": {
        "@koishijs/plugin-database-memory": "^3.7.0",
        "@types/chai": "^4.3.20",
        "@types/mocha": "^10.0.10",
        "@types/node": "^22.18.7",
        "atsc": "^2.1.0",
        "chai": "^4.4.1",
        "cross-env": "^7.0.3",
        "esbuild": "^0.25.10",
        "esbuild-register": "npm:@shigma/esbuild-register@^1.1.1",
        "koishi": "^4.18.9",
        "mocha": "^9.2.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.2"
    },
    "peerDependencies": {
        "koishi": "^4.18.9"
    }
}
